{
  "name": "omnideck",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "全能桌面，智驭未来 · Your All-in-One AI-Powered Desktop Toolkit",
  "author": "OmniDeck",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:clean": "kill -9 $(lsof -ti:5173) 2>/dev/null; electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "release": "bash scripts/release-upload.sh"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.75",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@tobilu/qmd": "^2.8.3",
    "adm-zip": "^0.6.1",
    "codemirror": "^5.65.21",
    "crypto-js": "^4.2.0",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.14.6",
    "gif.js": "^0.2.0",
    "hi-base32": "^0.5.1",
    "highlight.js": "^11.12.0",
    "js-beautify": "^1.15.4",
    "js-sha3": "^0.9.3",
    "js-yaml": "^4.3.2",
    "jsencrypt": "^3.5.4",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.1",
    "mitt": "^3.0.1",
    "node-forge": "^1.4.0",
    "pdf-parse": "^1.1.1",
    "pi-subagents": "^0.70.0",
    "pi-web-access": "^0.31.0",
    "qrcode": "^1.5.4",
    "relationship.js": "^1.2.9",
    "solarlunar": "^2.0.7",
    "sql-formatter": "^15.8.2",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fast-glob": "^3.3.3",
    "node-addon-api": "^8.9.2",
    "sass": "^1.69.0",
    "tree-kill": "^1.2.2",
    "vite": "^5.4.21",
    "vite-plugin-svg-icons": "^2.0.1",
    "vuedraggable": "^4.1.0"
  },
  "build": {
    "appId": "com.omnideck.app",
    "productName": "OmniDeck",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "artifactName": "OmniDeck-${version}-${os}-${arch}.${ext}",
    "afterPack": "./scripts/afterPack.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitcode.com/m0_59492087/OmniDeck/releases/download/v0.0.0/"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "src/config/remote.cjs",
      "native/build/Release/*.node",
      "node_modules/@tobilu/qmd/**/*",
      "!node_modules/@tobilu/qmd/**/*.md"
    ],
    "asarUnpack": [
      "node_modules/@tobilu/qmd/**",
      "native/build/Release/*.node"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "tray",
        "filter": [
          "logo.png",
          "trayTemplate.png",
          "trayTemplate@2x.png",
          "trayTemplate@4x.png",
          "tray-win.png"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniDeck"
    }
  }
}
