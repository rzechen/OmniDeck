{
  "name": "omnideck",
  "version": "0.1.0",
  "private": true,
  "description": "全能桌面，智驭未来 · Your All-in-One AI-Powered Desktop Toolkit",
  "author": "OmniDeck",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win --x64",
    "build:all": "vite build && electron-builder --mac && electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.75",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "codemirror": "^5.65.21",
    "crypto-js": "^4.2.0",
    "element-ui": "^2.15.14",
    "gif.js": "^0.2.0",
    "hi-base32": "^0.5.1",
    "highlight.js": "^11.12.0",
    "js-beautify": "^1.15.4",
    "js-sha3": "^0.9.3",
    "js-yaml": "^4.3.2",
    "jsencrypt": "^3.5.4",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.1",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "relationship.js": "^1.2.9",
    "solarlunar": "^2.0.7",
    "sql-formatter": "^15.8.2",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "fast-glob": "^3.3.3",
    "sass": "^1.69.0",
    "vite": "^4.5.5",
    "vite-plugin-electron": "^0.15.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vuedraggable": "^2.24.3"
  },
  "build": {
    "appId": "com.omnideck.app",
    "productName": "OmniDeck",
    "directories": {
      "output": "release"
    },
    "artifactName": "OmniDeck-${version}-${os}-${arch}.${ext}",
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniDeck"
    }
  }
}
